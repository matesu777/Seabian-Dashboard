package components

import "github.com/matesu777/Seabian-dashboard/internal/models"
import "github.com/matesu777/Seabian-dashboard/internal/utils"

templ StorageStats(data models.Response) {
	{{ used, total := utils.TotalDisk(data) }}
	<div>
		<h2>Storage</h2>
		<div>
			<p>
				Used: { utils.FormatBytes(used) }
			</p>
			<p>
				Total: { utils.FormatBytes(total) }
			</p>
			<span>progress bar</span>
		</div>
	</div>
}
