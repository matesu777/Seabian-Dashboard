package components

import (
	"github.com/matesu777/Seabian-dashboard/internal/models"
	"github.com/matesu777/Seabian-dashboard/internal/utils"
)

templ SystemStats(data models.Response) {
	<div
		id="system-stats"
		hx-get="/system-stats"
		hx-trigger="every 1s"
		hx-swap="outerHTML"
	>
		<h2>System</h2>
		<div class="stats">
			<div class="circle">
				<span>CPU</span>
				<strong>{ utils.FormatUsageCPU(data.Hardware.CPU.Usage) }</strong>
				<span>{ utils.FormatTemp(data.Hardware.Temperature.CPU) }</span>
			</div>
			<div class="circle">
				<span>RAM</span>
				<strong>{ utils.FormatBytes(data.Hardware.Memory.Used) }</strong>
				<span>{ utils.PercentRAM(data.Hardware.Memory) }</span>
			</div>
		</div>
	</div>
}
