package components

import "time"

templ Clock() {
	<div id="clock">
		<h2 id="clock-time">{ time.Now().Format("15:04") }</h2>
		<p>{ time.Now().Format("Monday, Jan 2, 2006") }</p>
	</div>
	<script>
		function updateClock() {
			const clock = document.getElementById("clock-time");

			if (!clock) return;

			const now = new Date();

			clock.textContent = now.toLocaleTimeString("pt-BR", {
				hour: "2-digit",
				minute: "2-digit"
			});
		}

		updateClock();
		setInterval(updateClock, 1000);
	</script>
}
